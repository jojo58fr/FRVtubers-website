generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                     String    @id @default(cuid())
  name                   String?
  email                  String?   @unique
  emailVerified          DateTime?
  image                  String?
  discordId              String?   @unique
  discordAvatar          String?
  discordIsMember        Boolean?
  discordPending         Boolean?
  discordRoles           String?
  discordMemberFetchedAt DateTime?
  adminRole              AdminRole @default(MEMBER)
  theme                  String    @default("light")
  language               String    @default("fr")
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  magazines Magazine[] @relation("MagazinesCreated")
}

enum AdminRole {
  MEMBER
  MODERATOR
  COMITE
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Magazine {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  issueNumber   String?
  releaseDate   DateTime
  description   String?
  pdfPath       String
  coverImageUrl String
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String?

  createdBy User? @relation("MagazinesCreated", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([releaseDate])
}
